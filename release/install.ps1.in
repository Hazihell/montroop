# Installs Kunumy on Windows (github.com/Hazihell/kunumy), in PowerShell (7,
# or Windows PowerShell 5.1):
#   irm https://github.com/Hazihell/kunumy/releases/latest/download/install.ps1 | iex
# (or this release's own: .../releases/download/@VER@/install.ps1, the only
# line for a release candidate, N.rcM)
#
# Like install.sh: downloads kny-<ver>-windows-<arch>.zip from this
# release, checks its sha256, and puts its kny.exe at $env:KNY_BIN (default
# %LOCALAPPDATA%\Programs\kunumy\kny.exe), adding that folder to your user
# PATH. No admin. Your data stays in %USERPROFILE%\.kunumy ($env:KNY_DIR)
# and %USERPROFILE%\.config\kunumy, as on Linux. Every time, it writes the
# fixed prompts (prompts/*.md) to %LOCALAPPDATA%\kunumy (edits there are
# overwritten). With KNY_BIN set to an installed kny.exe it replaces that
# one: a running exe can't be overwritten, only renamed, so the one replaced is left as
# kny.exe.old, or .old-<n> (kny removes those exact names at its next
# start). The background services kny made (`kny serve -d`, `kny device
# -d`: the Scheduled Tasks kny-serve and kny-device, their description
# holding "kny-made") that run are restarted on the new exe once it is in
# place, by Task Scheduler (a run asked for while one runs stops that one
# first). While any other kny device or server runs this stops, changing
# nothing: stop it, run this, start it again. A terminal chat may stay
# open (it keeps the old version till it quits).
#
# Every time, data from an older Kunumy is brought to this version's layout
# (upgrade.js, by the new kny.exe as bun: each step once, with the server
# stopped meanwhile, and started again after).
# It ends setting $LASTEXITCODE (0: installed, 1: not), never `exit`:
# run by `irm | iex`, an exit would close your PowerShell window.

& {
  $ErrorActionPreference = 'Stop'
  $ProgressPreference = 'SilentlyContinue'
  $Ver = '@VER@'
  $Base = "https://github.com/Hazihell/kunumy/releases/download/$Ver"
  $Sums = @{ 'x64' = '@SUM_windows-x64@'; 'arm64' = '@SUM_windows-arm64@' }
  $Self = "$Base/install.ps1"
  $tmp = $null
  # the tasks this stopped, which a failure starts again (as install.sh does)
  $stopped = @()
  try {
    if ([Environment]::OSVersion.Platform -ne 'Win32NT') {
      throw "this installer is Windows'; on Linux or macOS: curl -fsSL $Base/install.sh | sh"
    }
    $arch = $env:PROCESSOR_ARCHITEW6432
    if (-not $arch) { $arch = $env:PROCESSOR_ARCHITECTURE }
    switch ($arch) {
      'AMD64' { $arch = 'x64' }
      'ARM64' { $arch = 'arm64' }
      default { throw "$arch is not supported: x64 and arm64 only." }
    }
    $bin = $env:KNY_BIN
    if (-not $bin) { $bin = Join-Path $env:LOCALAPPDATA 'Programs\kunumy\kny.exe' }
    $dir = $env:KNY_DIR
    if (-not $dir) { $dir = Join-Path $HOME '.kunumy' }
    $task = { param($n) try { Get-ScheduledTask -TaskName $n -TaskPath '\' -ErrorAction Stop } catch { $null } }
    # a download, tried 3 times: a dropped connection, a body cut short of
    # its Content-Length (Invoke-WebRequest keeps what came) and one $bad
    # finds fault with (its why, else nothing) are tried again
    $fetch = {
      param($w, $bad)
      for ($k = 1; ; $k++) {
        try {
          $o = @{} + $w
          if ($o.OutFile) { $o.PassThru = $true }
          $r = Invoke-WebRequest -UseBasicParsing @o
          $want = [string]@($r.Headers['Content-Length'])[0]
          $got = $(if ($o.OutFile) { (Get-Item -LiteralPath $o.OutFile).Length } else { $r.RawContentLength })
          if ($want -match '^[0-9]+$' -and [long]$want -ne [long]$got) { throw "it was cut short: $got of $want bytes came" }
          $why = $(if ($bad) { & $bad $r })
          if ($why) { throw $why }
          return $r
        } catch { if ($k -ge 3) { throw }; Start-Sleep -Seconds 2 }
      }
    }

    # a kny device or server running (a kny.exe, or one by $bin's name or
    # path) that no service runs: it would keep the old version, and its
    # data must not change under it. One whose command line Windows doesn't
    # show (CIM failing, another user's, an elevated one) counts as
    # running; a service's supervisor (`--service`) and what it started, which the restart below
    # ends. A service that runs elevated (`sudo kny device -d`) shows no
    # command line to a shell that isn't: its supervisor and kny are known
    # by the pids it wrote (logs\<part>.pid), while its task runs
    $leaf = Split-Path -Leaf $bin
    $names = @('kny.exe', $leaf)
    $procs = $null
    $mine = ''
    try {
      $all = @(Get-CimInstance Win32_Process -ErrorAction Stop)
      $up = @{}
      foreach ($p in $all) { $up[[string]$p.ProcessId] = [string]$p.ParentProcessId }
      $sups = @($all | Where-Object { ($names -icontains $_.Name) -and ([string]$_.CommandLine -match '\s"?--service"?(\s|$)') } | ForEach-Object { [string]$_.ProcessId })
      foreach ($part in 'serve', 'device') {
        $t = & $task "kny-$part"
        if ($t -and ([string]$t.Description -match 'kny-made') -and ([string]$t.State -eq 'Running')) {
          try { $sups += @((Get-Content -LiteralPath (Join-Path $dir "logs\$part.pid") -ErrorAction Stop) -split '\s+' | Where-Object { $_ -match '^[0-9]+$' }) } catch {}
        }
      }
      $served = { param($id) for ($k = 0; $k -lt 8 -and $id; $k++) { if ($sups -contains $id) { return $true }; $id = $up[$id] }; return $false }
      # the supervisor this runs under, if any (an install run from a service's shell): its command line
      $id = [string]$PID
      for ($k = 0; $k -lt 16 -and $id; $k++) { if ($sups -contains $id) { $mine = [string]($all | Where-Object { [string]$_.ProcessId -eq $id } | Select-Object -First 1).CommandLine; break }; $id = $up[$id] }
      $procs = @($all | Where-Object { ($names -icontains $_.Name) -or ($_.ExecutablePath -and $_.ExecutablePath -ieq $bin) } | Where-Object { -not (& $served ([string]$_.ProcessId)) } | ForEach-Object { [pscustomobject]@{ Id = [string]$_.ProcessId; Line = [string]$_.CommandLine } })
    } catch {
      $stems = @($names) + @($names | ForEach-Object { [IO.Path]::GetFileNameWithoutExtension($_) })
      $procs = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $stems -icontains $_.ProcessName } | ForEach-Object { [pscustomobject]@{ Id = [string]$_.Id; Line = '' } })
    }
    $busy = @($procs | Where-Object { $_.Line -match '\s"?(device|serve)"?(\s|$)' })
    $blind = @($procs | Where-Object { $_.Line -eq '' })
    $again = "Stop it (taskkill /T /F /PID <pid>; if a Scheduled Task you made runs it, first Disable-ScheduledTask and Stop-ScheduledTask it), run this again (irm $Self | iex), then start it again. Run as kny device -d (or kny serve -d) instead, it's restarted by installs."
    if ($busy.Count -gt 0) {
      throw ("a device or server runs (pid " + (($busy | ForEach-Object { $_.Id }) -join ', ') + "). Nothing changed, and Kunumy $Ver was not installed. $again")
    }
    if ($blind.Count -gt 0) {
      throw ("kny runs (pid " + (($blind | ForEach-Object { $_.Id }) -join ', ') + "), and Windows won't say whether as a device or server. Nothing changed, and Kunumy $Ver was not installed. Quit every one (a terminal chat too), or: $again")
    }

    try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch {}
    $name = "kny-$Ver-windows-$arch.zip"
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('kny-' + [guid]::NewGuid())
    New-Item -ItemType Directory -Path $tmp | Out-Null
    $zip = Join-Path $tmp $name
    Write-Host "downloading $Base/$name"
    $sha = { if ((Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash.ToLower() -ne $Sums[$arch]) { 'it does not match its sha256' } }
    try {
      & $fetch @{ Uri = "$Base/$name"; OutFile = $zip } $sha | Out-Null
    } catch {
      throw "the download failed: $name ($($_.Exception.Message)); not installed"
    }
    Expand-Archive -LiteralPath $zip -DestinationPath (Join-Path $tmp 'x')
    $exe = Join-Path $tmp 'x\kny.exe'
    if (-not (Test-Path -LiteralPath $exe)) { throw "$name holds no kny.exe; not installed" }
    $upgrade = Join-Path $tmp 'upgrade.js'
    [IO.File]::WriteAllText($upgrade, [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('@UPGRADE_JS_B64@')))

    # no server may run on the data while its layout changes: kny-serve, if
    # it runs, stops meanwhile, to start again below. A device keeps no data
    # there
    $halted = @()
    $upgrading = $false
    if (Test-Path -LiteralPath $dir -PathType Container) {
      $env:BUN_BE_BUN = '1'
      try { & $exe $upgrade check $dir } finally { Remove-Item Env:\BUN_BE_BUN -ErrorAction SilentlyContinue }
      if ($LASTEXITCODE -eq 3) { $upgrading = $true } elseif ($LASTEXITCODE -ne 0) { throw "nothing changed; Kunumy $Ver was not installed." }
    }
    if ($upgrading) {
      if ($mine -match '\s"?serve"?(\s|$)') {
        throw "your data must change with no kny server running, and this runs in a shell of kny-serve, which stopping would end. Nothing changed, and Kunumy $Ver was not installed: run this installer in a terminal."
      }
      $halted = @(& $task 'kny-serve' | Where-Object { $_ -and ([string]$_.Description -match 'kny-made') -and ([string]$_.State -eq 'Running') })
      # the tasks stopped, started again: "Nothing changed", else which
      # stay stopped and how to start them
      $restart = {
        param($ts)
        $left = @(foreach ($t in $ts) { try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop } catch { [pscustomobject]@{ Name = $t.TaskName; Why = $_.Exception.Message; High = ([string]$t.Principal.RunLevel -eq 'Highest') } } })
        if ($left.Count -eq 0) { return 'Nothing changed' }
        'Nothing changed but this: ' + (($left | ForEach-Object { $_.Name + ' (' + $_.Why + ')' }) -join ', ') + ' could not start again, so ' + $(if ($left.Count -eq 1) { 'it stays' } else { 'they stay' }) + ' stopped: start ' + $(if ($left.Count -eq 1) { 'it' } else { 'them' }) + ' with ' + (($left | ForEach-Object { 'schtasks /run /tn ' + $_.Name + $(if ($_.High) { ' (as administrator)' } else { '' }) }) -join ', ')
      }
      $done = @()
      foreach ($t in $halted) {
        try {
          Stop-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop
          $done += $t
        } catch {
          $why = $_.Exception.Message
          throw ("could not stop the task " + $t.TaskName + " ($why). " + (& $restart $done) + ", and Kunumy $Ver was not installed: run this again" + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { ' as administrator' } else { '' }) + ".")
        }
      }
      # the one whose pid server.pid holds must be gone (waited for up to
      # 10 s), else nothing changes and the stopped tasks start again
      $live = { $p = 0; try { $p = [int]((Get-Content -LiteralPath (Join-Path $dir 'server.pid') -ErrorAction Stop) | Select-Object -First 1) } catch {}; ($p -gt 0) -and ($null -ne (Get-Process -Id $p -ErrorAction SilentlyContinue)) }
      for ($k = 0; $k -lt 20 -and (& $live); $k++) { Start-Sleep -Milliseconds 500 }
      if (& $live) {
        throw ("your data must change with no server running, but one still runs on it (its pid is in $dir\server.pid). " + (& $restart $halted) + ", and Kunumy $Ver was not installed: stop it, run this again, then start it.")
      }
      $stopped = @($done)
    }

    # every time: older data to this version's layout, each step once
    if (Test-Path -LiteralPath $dir -PathType Container) {
      $env:BUN_BE_BUN = '1'
      try { & $exe $upgrade $dir } finally { Remove-Item Env:\BUN_BE_BUN -ErrorAction SilentlyContinue }
      if ($LASTEXITCODE -ne 0) { throw "bringing your data in $dir to Kunumy $Ver's layout stopped halfway (see above): run this again. Kunumy $Ver was not installed." }
    }
    $share = Join-Path $env:LOCALAPPDATA 'kunumy'
    New-Item -ItemType Directory -Force -Path $share | Out-Null
@PROMPT_FILES_PS1@

    # beside $bin first (temp may be another drive), then swapped in: the
    # old exe renamed (it may run), the old
    # ones that no longer run removed
    $folder = Split-Path -Parent $bin
    $new = "$bin.new"
    try {
      New-Item -ItemType Directory -Force -Path $folder | Out-Null
      Copy-Item -LiteralPath $exe -Destination $new -Force
    } catch {
      throw "could not write $bin ($($_.Exception.Message))"
    }
    $old = $null
    if (Test-Path -LiteralPath $bin) {
      $olds = '^' + [regex]::Escape($leaf) + '\.old(-[0-9]+)?$'
      Get-ChildItem -LiteralPath $folder -File | Where-Object { $_.Name -match $olds } | ForEach-Object { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }
      $old = "$bin.old"
      for ($k = 2; Test-Path -LiteralPath $old; $k++) { $old = "$bin.old-$k" }
      Move-Item -LiteralPath $bin -Destination $old
    }
    try {
      Move-Item -LiteralPath $new -Destination $bin
    } catch {
      if ($old) { Move-Item -LiteralPath $old -Destination $bin }
      Remove-Item -LiteralPath $new -Force -ErrorAction SilentlyContinue
      throw "could not write $bin ($($_.Exception.Message))"
    }

    Write-Host ""
    Write-Host ("  Kunumy $Ver" + $(if ($Ver -match '\.rc') { ' (release candidate)' } else { '' }) + " is installed at $bin.")
    Write-Host "  Server: kny serve -d   Device: kny device -d <url>"
    # the user PATH, as written (REG_EXPAND_SZ, %VARS% kept), then a
    # setting's change told to Windows, so new terminals find kny: unless
    # the saved user or machine Path has the folder (this shell's own
    # $env:Path may have it only for now); this shell's gets it too
    $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)
    $path = [string]$key.GetValue('Path', '', 'DoNotExpandEnvironmentNames')
    $have = @($path -split ';' | Where-Object { $_ -ne '' })
    $machine = @(([string][Environment]::GetEnvironmentVariable('Path', 'Machine')) -split ';' | Where-Object { $_ -ne '' })
    $same = { param($p, $f) [Environment]::ExpandEnvironmentVariables($p).TrimEnd('\') -ieq $f.TrimEnd('\') }
    if (@($have + $machine | Where-Object { & $same $_ $folder }).Count -eq 0) {
      $key.SetValue('Path', (@($have + $folder) -join ';'), [Microsoft.Win32.RegistryValueKind]::ExpandString)
      [Environment]::SetEnvironmentVariable('KNY_PATH_SET', '1', 'User')
      [Environment]::SetEnvironmentVariable('KNY_PATH_SET', [NullString]::Value, 'User')
      Write-Host "  Added $folder to your PATH: open a new terminal to run kny by name."
    }
    $key.Close()
    if (@($env:Path -split ';' | Where-Object { $_ -ne '' -and (& $same $_ $folder) }).Count -eq 0) {
      $env:Path = "$env:Path;$folder"
    }
    $global:LASTEXITCODE = 0
    # last: kny's tasks that run, restarted on the new exe by Task
    # Scheduler (run from such a service's shell, this ends
    # with it: so that one goes last, else the device, whose shells run
    # such installs)
    $made = @()
    try { $made = @('serve', 'device' | ForEach-Object { & $task "kny-$_" } | Where-Object { $_ -and ([string]$_.Description -match 'kny-made') -and ([string]$_.State -eq 'Running') }) } catch {}
    $made = @($made | Sort-Object { $mine -match ('\s"?' + $_.TaskName.Substring(4) + '"?\s') }, { $_.TaskName -eq 'kny-device' })
    $stopped = @()
    foreach ($t in $halted) {
      Write-Host ("  Starting " + $t.TaskName + " again, on Kunumy $Ver.")
      try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop } catch { Write-Host ("  Could not start " + $t.TaskName + ": run kny " + $t.TaskName.Substring(4) + " -d to.") }
    }
    foreach ($t in $made) {
      Write-Host ("  Restarting " + $t.TaskName + " on Kunumy $Ver.")
      try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop } catch { Write-Host ("  Could not restart " + $t.TaskName + ": run " + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { 'sudo ' } else { '' }) + "kny " + $t.TaskName.Substring(4) + " -d to.") }
    }
  } catch {
    Write-Host ("kny: " + $_.Exception.Message) -ForegroundColor Red
    foreach ($t in $stopped) {
      try {
        Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop
        Write-Host ("  Started " + $t.TaskName + " again.")
      } catch {
        Write-Host ("  Could not start " + $t.TaskName + " again (" + $_.Exception.Message + "): start it with schtasks /run /tn " + $t.TaskName + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { ' (as administrator)' } else { '' }) + ".")
      }
    }
    $global:LASTEXITCODE = 1
  } finally {
    if ($tmp) { Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue }
  }
}
